---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="page" id="top">
    <header class="site-header">
      <a class="wordmark" href="#top" aria-label="Donggil Shin, home">donggil<span>.dev</span></a>
      <nav aria-label="Main navigation">
        <a href="#work">Work</a>
        <a href="#about">About</a>
        <a href="https://github.com/dgshin37">GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="intro">
        <div class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Donggil Shin <span class="separator">/</span> Boston, MA</div>
        <h1 id="intro">Product engineering.<br /><span>Applied AI.</span></h1>
        <div class="hero-bottom">
          <p class="intro">I build products end to end, combining product design, software engineering, and applied AI.</p>
          <a class="work-link" href="#work">Explore the work <span aria-hidden="true">↓</span></a>
        </div>
        <div class="credentials"><span>MIT · Mathematics with Computer Science</span><span>Open to applied AI & product engineering roles</span></div>
      </section>
      <div class="work-layout" id="work">
        <aside class="work-index" aria-label="Project index">
          <p class="eyebrow">Selected work <span class="count">04</span></p>
          <nav aria-label="Projects">
            {projects.map((project, i) => (
              <a href={`#${project.id}`}><span class="index-number">0{i + 1}</span>{project.name}<span class="index-arrow" aria-hidden="true">↗</span></a>
            ))}
          </nav>
          <p class="index-note">Products, experiments,<br />and things I wanted to exist.</p>
        </aside>
        <div class="projects">
          {projects.map((project, i) => (
            <article id={project.id} class="project" aria-labelledby={`${project.id}-title`}>
              <div class="project-meta"><span class="eyebrow">0{i + 1} / {project.category}</span><div class="project-context"><span class="project-period">{project.period}</span><span class="project-status">{project.status}</span></div></div>
              <h2 id={`${project.id}-title`}>{project.name}<span class="title-period">.</span></h2>
              <p class="subtitle">{project.subtitle}</p>
              <div class="project-description">{project.description.map((paragraph) => <p>{paragraph}</p>)}</div>
              <ul class="tags" aria-label={`${project.name} skills`}>{project.tags.map((tag) => <li>{tag}</li>)}</ul>
              {project.links.length > 0 && <div class="project-links">{project.links.map((link, linkIndex) => (
                <a class:list={['project-link', { primary: linkIndex === 0 }]} href={link.href}>{link.label}<span aria-hidden="true">↗</span></a>
              ))}</div>}
              {project.details.length > 0 && <details class="case-study">
                <summary>{project.detailLabel}<span class="expand-icon" aria-hidden="true"></span></summary>
                <div class="case-study-content">{project.details.map((detail) => <section><h3>{detail.title}</h3><p>{detail.text}</p></section>)}</div>
              </details>}
            </article>
          ))}
        </div>
      </div>
      <section class="about" id="about" aria-labelledby="about-title">
        <p class="eyebrow">A little about me</p>
        <div><h2 id="about-title">From the idea<br />to the working thing.</h2>
          <p>I’m Donggil, a product engineer and MIT graduate in Mathematics with Computer Science. I work across product design, software engineering, and applied AI, with a particular interest in the decisions that make a model useful in a real product.</p>
          <p>I’m currently building Melosofia and open to applied AI and product engineering roles.</p>
          <a class="text-link" href="https://github.com/dgshin37">Find me on GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>
    <footer><span>© {new Date().getFullYear()} Donggil Shin</span><span>Made with care. Built with Astro.</span><a href="#top">Back to top <span aria-hidden="true">↑</span></a></footer>
  </div>
</BaseLayout>

<style>
  .page { max-width: 88rem; margin: 0 auto; padding: 0 clamp(1.25rem, 5vw, 5rem); }
  .skip-link { position: absolute; top: -5rem; left: 1rem; z-index: 10; padding: 1rem; background: var(--ink); color: white; }
  .skip-link:focus { top: 1rem; }
  .site-header { display: flex; align-items: center; justify-content: space-between; min-height: 6.5rem; gap: 1rem; border-bottom: 1px solid var(--line); }
  .wordmark { font-size: 1.2rem; letter-spacing: -.045em; font-weight: 750; text-decoration: none; }
  .wordmark span { color: var(--muted); font-weight: 400; }
  .site-header nav { display: flex; gap: clamp(1rem, 3vw, 2.5rem); font-size: .85rem; }
  .site-header nav a { text-decoration: none; padding: .5rem 0; }
  a:hover { color: var(--accent); }
  .hero { padding: clamp(3.5rem, 8vw, 7rem) 0 0; }
  .eyebrow { font-size: .68rem; font-weight: 650; letter-spacing: .11em; text-transform: uppercase; line-height: 1.6; }
  .hero .eyebrow { display: flex; align-items: center; gap: .75rem; }
  .status-dot { width: .45rem; height: .45rem; border-radius: 50%; background: #688153; }
  .separator { color: #9b9f91; margin: 0 .3rem; }
  h1 { font-size: clamp(2.75rem, 6.6vw, 6rem); font-weight: 530; letter-spacing: -.065em; line-height: 1.08; margin: 1.6rem 0 2.2rem; }
  h1 > span { font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 400; color: var(--accent); letter-spacing: -.06em; }
  .hero-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; }
  .intro { max-width: 40rem; font-size: clamp(1rem, 1.6vw, 1.2rem); color: var(--muted); margin: 0; }
  .work-link { display: flex; align-items: center; gap: 2.5rem; font-size: .8rem; white-space: nowrap; text-decoration: none; border-bottom: 1px solid var(--ink); padding: .7rem 0; }
  .credentials { display: flex; flex-wrap: wrap; gap: .7rem 2.25rem; padding: 2rem 0; margin-top: 3rem; border-top: 1px solid var(--line); font-size: .73rem; color: var(--muted); }
  .credentials span + span::before { content: '↗'; margin-right: .7rem; color: var(--accent); }
  .work-layout { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); border-top: 1px solid var(--ink); padding-top: 3rem; scroll-margin-top: 1.5rem; }
  .work-index { position: sticky; top: 2rem; align-self: start; }
  .work-index > .eyebrow { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.8rem; }
  .count { font-size: .6rem; border: 1px solid var(--line); padding: .1rem .4rem; border-radius: 1rem; }
  .work-index nav { display: flex; flex-direction: column; }
  .work-index nav a { display: flex; align-items: center; gap: .85rem; font-size: .83rem; text-decoration: none; padding: .9rem 0; border-bottom: 1px solid var(--line); }
  .index-number { color: var(--muted); font-size: .62rem; font-variant-numeric: tabular-nums; }
  .index-arrow { margin-left: auto; color: var(--muted); }
  .index-note { color: var(--muted); font-size: .75rem; margin-top: 1.75rem; }
  .project { padding: 0 0 3.5rem; scroll-margin-top: 2rem; }
  .project + .project { border-top: 1px solid var(--line); padding-top: 3.5rem; }
  .project-meta { display: flex; flex-wrap: wrap; gap: .6rem 1.5rem; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; }
  .project-meta .eyebrow { font-size: .61rem; color: var(--muted); }
  .project-context { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; }
  .project-period { color: var(--muted); font-size: .65rem; font-variant-numeric: tabular-nums; }
  .project-status { font-size: .65rem; border: 1px solid #cfd7c6; background: #edf0e7; border-radius: 1rem; padding: .3rem .65rem; }
  h2 { font-weight: 550; letter-spacing: -.055em; line-height: 1.15; }
  .project h2 { font-size: clamp(2.4rem, 4.4vw, 3.65rem); margin-bottom: .6rem; }
  .title-period { color: var(--accent); }
  .subtitle { font-family: Georgia, 'Times New Roman', serif; font-size: clamp(1.2rem, 2vw, 1.5rem); line-height: 1.4; margin-bottom: 1.6rem; }
  .project-description { color: #4d5850; max-width: 46rem; font-size: .96rem; }
  .project-description p { margin-bottom: 1rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem .5rem; padding: 0; margin: 1.6rem 0 0; list-style: none; }
  .tags li { font-size: .64rem; line-height: 1.5; padding: .35rem .6rem; border: 1px solid var(--line); border-radius: .2rem; color: var(--muted); }
  .project-links { display: flex; flex-wrap: wrap; gap: .6rem; margin-top: 1.7rem; }
  .project-link { display: inline-flex; justify-content: space-between; align-items: center; gap: 1.8rem; border: 1px solid var(--line); border-radius: .2rem; padding: .85rem 1rem; font-size: .77rem; text-decoration: none; }
  .project-link.primary { background: var(--ink); border-color: var(--ink); color: #f5f3ee; }
  .project-link:hover { background: #e7e9e0; color: var(--ink); }
  .project-link.primary:hover { background: #384f40; color: white; }
  .case-study { margin-top: 1.9rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  summary { padding: 1.2rem 0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; cursor: pointer; font-size: .8rem; font-weight: 600; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--accent); }
  .expand-icon { position: relative; width: 1rem; height: 1rem; flex-shrink: 0; }
  .expand-icon::before, .expand-icon::after { content: ''; position: absolute; background: currentColor; }
  .expand-icon::before { left: 0; right: 0; height: 1px; top: 50%; }
  .expand-icon::after { top: 0; bottom: 0; width: 1px; left: 50%; }
  details[open] .expand-icon::after { display: none; }
  .case-study-content { padding: .6rem 0 1rem; }
  .case-study-content section { margin-bottom: 1.5rem; }
  .case-study-content h3 { font-size: .88rem; margin-bottom: .5rem; font-weight: 650; }
  .case-study-content p { color: #4d5850; font-size: .88rem; margin-bottom: 0; }
  .about { display: grid; grid-template-columns: 13rem minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); padding: 3.5rem 0 4.5rem; border-top: 1px solid var(--ink); scroll-margin-top: 2rem; }
  .about h2 { font-size: clamp(2rem, 3.6vw, 3rem); margin-bottom: 1.5rem; }
  .about > div { max-width: 40rem; }
  .about p:not(.eyebrow) { font-size: .96rem; color: var(--muted); }
  .text-link { font-size: .85rem; }
  footer { border-top: 1px solid var(--line); padding: 1.75rem 0; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; font-size: .66rem; color: var(--muted); }
  footer a { text-decoration: none; }
  @media (max-width: 850px) {
    .work-layout, .about { grid-template-columns: minmax(0, 1fr); gap: 2.5rem; }
    .work-index { position: static; }
    .work-index > .eyebrow { margin-bottom: .6rem; }
    .work-index nav { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.5rem; }
    .index-note { display: none; }
    .hero-bottom { align-items: flex-start; flex-direction: column; gap: 1.25rem; }
    .about { gap: 1rem; }
  }
  @media (max-width: 480px) {
    .site-header { min-height: 5rem; }
    .site-header nav { font-size: .75rem; }
    .wordmark { font-size: 1.05rem; }
    .hero .eyebrow { font-size: .6rem; gap: .5rem; }
    h1 { font-size: clamp(2rem, 8.6vw, 2.8rem); }
    .credentials { margin-top: 2rem; font-size: .66rem; }
    .project-meta { align-items: flex-start; flex-direction: column; }
    .project-meta .eyebrow { font-size: .58rem; }
    .project { padding-bottom: 2.5rem; }
    .project + .project { padding-top: 2.5rem; }
    footer span:nth-child(2) { display: none; }
  }
</style>
